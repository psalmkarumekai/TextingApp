@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5" style="max-width: 600px;">
    <h3 class="mb-4 text-center">Real-Time Chat</h3>
    
    <!-- Input Fields -->
    <div class="card p-3 shadow-sm mb-3">
        <div class="mb-2">
            <input type="text" id="userInput" class="form-control" placeholder="Enter your name..." />
        </div>
        <div class="input-group">
            <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." disabled />
            <button id="sendButton" class="btn btn-primary" disabled>Send</button>
        </div>
    </div>

    <!-- Chat Messages Window -->
    <div class="card shadow-sm p-3" style="height: 350px; overflow-y: auto; background: #f8f9fa;">
        <ul id="messagesList" class="list-unstyled"></ul>
    </div>
</div>

<!-- Load SignalR Script from CDN -->
<script src="https://cloudflare.com"></script>

<script>
    // 1. Establish connection to the ASP.NET Core SignalR hub
    const connection = new signalr.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    const sendBtn = document.getElementById("sendButton");
    const msgInput = document.getElementById("messageInput");

    // 2. Disable send button until connection is established
    sendBtn.disabled = true;

    // 3. Listen for incoming messages from the server
    connection.on("ReceiveMessage", function (user, message) {
        const li = document.createElement("li");
        li.className = "mb-2 p-2 bg-white rounded shadow-sm";
        li.innerHTML = `<strong>${user}:</strong> ${message}`;
        
        const list = document.getElementById("messagesList");
        list.appendChild(li);
        
        // Auto-scroll to the bottom of the chat window
        list.parentElement.scrollTop = list.parentElement.scrollHeight;
    });

    // 4. Start the connection
    connection.start().then(function () {
        sendBtn.disabled = false;
        msgInput.disabled = false;
    }).catch(function (err) {
        return console.error(err.toString());
    });

    // 5. Send message event
    sendBtn.addEventListener("click", function (event) {
        const user = document.getElementById("userInput").value || "Anonymous";
        const message = msgInput.value;
        
        if(message.trim() !== "") {
            connection.invoke("SendMessage", user, message).catch(function (err) {
                return console.error(err.toString());
            });
            msgInput.value = ""; // Clear input box
        }
        event.preventDefault();
    });
</script>
